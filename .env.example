# ==============================================================================
# STARVYON Learn - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or modify 'env.js' to configure runtime environments.
# Do NOT commit actual secrets, private tokens, or production API keys to git.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="STARVYON Learn"
APP_URL=http://localhost:3000
APP_VERSION=1.0.0
DEBUG=true

# API & Gateway Configuration
API_BASE_URL=http://localhost:8000/api/v1
API_TIMEOUT_MS=15000

# Database Configuration (Neon Serverless PostgreSQL)
# Obtain from Neon console: https://console.neon.tech
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
NEON_DATABASE_URL=
NEON_API_KEY=
DATABASE_DRIVER=neon
DATABASE_POOL_SIZE=10

# Authentication & Persistence
ENABLE_MOCK_AUTH=true
AUTH_TOKEN_KEY=starvyon_active_session
AUTH_STORAGE_KEY=starvyon_users_db
PROGRESS_KEY_PREFIX=starvyon_progress_
SESSION_EXPIRY_HOURS=72

# AI Services & LLM Sandboxes (Used for interactive labs & dynamic code checks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-pro

# Observability & Analytics
ANALYTICS_ENABLED=false
ANALYTICS_MEASUREMENT_ID=
SENTRY_DSN=

# Feature Flags
FEATURE_INTERACTIVE_LABS=true
FEATURE_PROGRESS_RADAR=true
FEATURE_COURSE_QUIZZES=true
FEATURE_OFFLINE_STORAGE=true
